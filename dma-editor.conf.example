# DMA-Memory-Editor configuration.
#
# Copy this file to dma-editor.conf (in the working directory or next to the
# executable) and edit as needed. Every setting can also be given on the
# command line -- run with --help for the list. Command line wins over the
# file, and the file wins over these defaults.

# --- Backend ---------------------------------------------------------------

# LeechCore device string. Leave unset (or empty) to autodetect:
#   Linux   -> qemu://hugepage-pid=<discovered pid>,qmp=<qmp_socket>
#   Windows -> fpga
#
# Examples:
#   device = fpga
#   device = qemu://hugepage-pid=4242,qmp=/tmp/qmp-win10.sock
#device =

# Process name to look for when autodetecting a QEMU guest.
qemu_process = qemu-system-x86

# QMP socket for the qemu device. Must match your QEMU invocation, e.g.
#   -qmp unix:/tmp/qmp-win10.sock,server,nowait
qmp_socket = /tmp/qmp-win10.sock

# --- MemProcFS mount -------------------------------------------------------
# Only used to recover a process DTB when a module lookup fails. Mounting
# needs a memprocfs binary and permission to mount FUSE filesystems; set
# mount_enabled = false to skip it entirely.

mount_enabled  = true
mount_point    = /mnt/memproc
memprocfs_path = ./memprocfs

# Second QMP socket, used by the memprocfs helper so it does not fight the
# main connection over the first one, e.g.
#   -qmp unix:/tmp/qmp-win10-1.sock,server,nowait
memprocfs_qmp = /tmp/qmp-win10-1.sock

# --- Debugger (Linux) ------------------------------------------------------
# Requires the guest to be started with a gdbstub, e.g. -gdb tcp::1234

gdb_path       = gdb
gdb_target     = localhost:1234
gdb_timeout_ms = 2000

# --- Misc ------------------------------------------------------------------

verbose = false
